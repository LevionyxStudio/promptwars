# Guardian Server-Side Gemini API Key Setup (Vercel Serverless Function)
# Add your Gemini API key below for local dev serverless functions.
# Note: When deploying to Vercel, add GEMINI_API_KEY in Vercel's Project Settings -> Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Web App Environment Variables (Vite exposed)
# Note: When deploying to Vercel, add these VITE_FIREBASE_* keys in Vercel's Project Settings -> Environment Variables.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
